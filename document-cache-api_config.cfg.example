# Настройки для локального запуска приложения.
# PostgreSQL: пользователь document_cache, пароль document_cache, БД document_cache.
# В Docker Compose замените localhost в DSN на имя сервиса PostgreSQL.

[server]
  host = "0.0.0.0"
  port = 8080
  read_timeout = "30s"
  write_timeout = "30s"
  idle_timeout = "120s"
  shutdown_timeout = "10s"

[log]
  level = "info"
  dir = "log"
  pretty = false
  to_file = false
  caller = false

[database]
  dsn = "postgres://document_cache:document_cache@localhost:5432/document_cache?sslmode=disable"

[auth]
  # Демонстрационный токен для локального тестирования регистрации.
  admin_token = "local-dev-admin-token"
  session_ttl = "24h"

[storage]
  dir = "data/files"
  # Максимальный размер multipart-запроса: 10 МиБ.
  max_upload_size = 10485760

[cache]
  max_entries = 1000
  # Максимальный суммарный размер тел ответов: 64 МиБ.
  max_bytes = 67108864

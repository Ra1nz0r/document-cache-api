# Настройки для локального запуска приложения.
# Файл .env сам по себе не загружается пакетом envdecode.
# Передайте переменные процессу через shell или env_file в Docker Compose.
# TOML-конфиг должен отсутствовать: если он найден, env не читается.

DOC_CACHE_SERVER_HOST=0.0.0.0
DOC_CACHE_SERVER_PORT=8080
DOC_CACHE_SERVER_READ_TIMEOUT=30s
DOC_CACHE_SERVER_WRITE_TIMEOUT=30s
DOC_CACHE_SERVER_IDLE_TIMEOUT=120s
DOC_CACHE_SERVER_SHUTDOWN_TIMEOUT=10s

DOC_CACHE_LOG_LEVEL=info
DOC_CACHE_LOG_DIR=log
DOC_CACHE_LOG_PRETTY=false
DOC_CACHE_LOG_TO_FILE=false
DOC_CACHE_LOG_CALLER=false

DOC_CACHE_DATABASE_DSN="postgres://document_cache:document_cache@localhost:5433/document_cache?sslmode=disable"

# Демонстрационный токен для локального тестирования регистрации.
DOC_CACHE_AUTH_ADMIN_TOKEN=local-dev-admin-token
DOC_CACHE_AUTH_SESSION_TTL=24h

DOC_CACHE_STORAGE_DIR=data/files
# Максимальный размер multipart-запроса: 10 МиБ.
DOC_CACHE_STORAGE_MAX_UPLOAD_SIZE=10485760

DOC_CACHE_CACHE_MAX_ENTRIES=1000
# Максимальный суммарный размер тел ответов: 64 МиБ.
DOC_CACHE_CACHE_MAX_BYTES=67108864
